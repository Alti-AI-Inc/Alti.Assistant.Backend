  "main": "index.js",
  "scripts": {
    "start": "node --require ./preload.cjs --dns-result-order=ipv4first index.js",
    "dev": "nodemon --require ./preload.cjs --dns-result-order=ipv4first index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:agents": "vitest run agents/**/tests/*.test.js",
    "test:search": "node test_enhanced_search.js",
    "test:transcription": "node scripts/test-transcription.js",
    "lint": "eslint . --fix --max-warnings=0",
    "format": "prettier . --write",
    "seed:stripe": "node scripts/seed-stripe-products.js",
    "seed:products": "node scripts/seed-products.js",
    "migrate:users": "node scripts/migrate-existing-users.js",
    "change-password": "node scripts/change-password.js",
    "mcp-toolbox:build": "cd mcp-toolbox && go build -o ../bin/mcp-toolbox .",
    "mcp-toolbox:start": "cd mcp-toolbox && go run ."
  },
