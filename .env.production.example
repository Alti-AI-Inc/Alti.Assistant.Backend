# ════════════════════════════════════════════════════════════════════════════════
#  APHURA BACKEND — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ════════════════════════════════════════════════════════════════════════════════
# Copy this file to .env on your backend deployment server:
# cp .env.production.example .env

NODE_ENV=production
PORT=5100
CLIENT_URL=https://aphura.ai

# ── Database & Redis ──────────────────────────────────────────────────────────
# Production MongoDB connection string (e.g. Atlas replica set or sovereign host)
DATABASE_LOCAL=mongodb+srv://admin:YOUR_PASSWORD@cluster0.mongodb.net/aphura_prod?retryWrites=true&w=majority
# Production Redis connection string (for BullMQ queues, pub/sub, rate limiting)
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@redis:6379

# ── Auth (JWT) ────────────────────────────────────────────────────────────────
# 64-character random secrets (generate with: openssl rand -hex 32)
JWT_ACCESS_TOKEN=your_random_jwt_access_token_secret_here
JWT_REFRESH_REFRESH_TOKEN=your_random_jwt_refresh_token_secret_here
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
CHAT_ENCRYPTION_KEY=your_32_byte_hex_chat_encryption_key_here

# ── 1. Together AI (Sole Sovereign Inference Provider) ────────────────────────
TOGETHER_API_KEY=your_live_together_ai_api_key_here
TOGETHER_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo
TOGETHER_LIGHT_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo

# ── 2. Exa.ai (Real-Time Neural Web Search & Deep Grounding) ──────────────────
EXA_API_KEY=your_live_exa_api_key_here

# ── 3. Composio (250+ Autonomous App Connectors & MCP Gateway) ───────────────
COMPOSIO_API_KEY=your_live_composio_api_key_here
COMPOSIO_BASE_URL=https://backend.composio.dev
COMPOSIO_MCP_URL=https://connect.composio.dev/mcp

# ── 4. Stripe (Sovereign Billing & Subscriptions) ─────────────────────────────
STRIPE_SECRET_KEY=sk_live_your_live_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_live_your_live_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_live_stripe_webhook_signing_secret_here

# ── 5. Cloudflare (Edge Network, WAF & Workers AI) ───────────────────────────
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id_here

# ── 6. Liberty Center One (Sovereign MinIO / Swift S3 Storage) ───────────────
OBJECT_STORAGE_ENDPOINT=storage.libertycenterone.com
OBJECT_STORAGE_PORT=443
OBJECT_STORAGE_ACCESS_KEY=your_liberty_access_key
OBJECT_STORAGE_SECRET_KEY=your_liberty_secret_key
OBJECT_STORAGE_REGION=us-east-1
UPLOADS_BUCKET=aphura-uploads
TRANSCRIPTION_BUCKET=aphura-transcription
KNOWLEDGE_BANK_BUCKET=aphura-knowledge-bank
KNOWLEDGEBOT_BUCKET=aphura-knowledgebot
PRESENTATION_BUCKET=aphura-presentations

# ── 7. Liberty Center One (OpenStack Compute, Networking, Key Management) ────
OPENSTACK_AUTH_URL=https://identity.libertycenterone.com/v3
OPENSTACK_USERNAME=your_openstack_username
OPENSTACK_PASSWORD=your_openstack_password
OPENSTACK_PROJECT_NAME=your_project_name
OPENSTACK_USER_DOMAIN_NAME=Default

# ── 8. Groq (Fast Classification & STT) ──────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── 9. Email (Liberty Center One SMTP) ────────────────────────────────────────
SMTP_HOST=smtp.libertycenterone.com
SMTP_PORT=587
SMTP_USER=noreply@aphurahq.com
SMTP_PASSWORD=your_smtp_password_here
SENDER_MAIL=noreply@aphurahq.com

# ── 10. LangSmith Tracing (Optional) ─────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=aphura-sovereign-production
