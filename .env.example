# Aphura AI — Backend Environment Configuration Template
# Copy to .env and configure for production/staging environments

# ── Core Server ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5100
CLIENT_URL=https://app.aphurahq.com
ALLOWED_ORIGINS=https://aphurahq.com,https://www.aphurahq.com,https://app.aphurahq.com
TRUST_PROXY=1

# ── Database (MongoDB) ───────────────────────────────────────────────────────
# Accepts DATABASE_LOCAL, MONGODB_URI, or MONGODB_URL
DATABASE_LOCAL=mongodb://mongodb:27017/aphura-ai

# ── Cache & Pub/Sub (Redis Stack) ───────────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_TOKEN_EXPIRES_IN=86400

# ── Authentication (JWT) ─────────────────────────────────────────────────────
JWT_ACCESS_TOKEN=your_secure_random_jwt_access_secret_here
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_REFRESH_TOKEN=your_secure_random_jwt_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d
SUPER_ADMIN_EMAIL=admin@aphurahq.com

# ── LLM Inference (Groq — Sovereign Single Source of Truth) ──────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=gpt-oss-120b
GROQ_LIGHT_MODEL=gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TEMPERATURE=0.2

# ── Neural Web Search (Exa.ai) ──────────────────────────────────────────────
EXA_API_KEY=your_exa_api_key_here

# ── Payments & Billing (Stripe) ──────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_WEBHOOK_SECRET_FALLBACK=
SECURITY_ALERT_WEBHOOK=https://discord.com/api/webhooks/your_alert_webhook

# ── Email Delivery (Liberty Center One SMTP) ────────────────────────────────
SMTP_HOST=smtp.libertycenterone.com
SMTP_PORT=587
SMTP_USER=no-reply@aphurahq.com
SMTP_PASSWORD=your_smtp_password_here
SENDER_MAIL=no-reply@aphurahq.com
CONFIRM_REG_EMAIL=https://app.aphurahq.com/confirm-registration

# ── Object Storage (Liberty Center One / MinIO / OpenStack Swift) ────────────
OBJECT_STORAGE_ENDPOINT=https://storage.libertycenterone.com
OBJECT_STORAGE_PORT=443
OBJECT_STORAGE_ACCESS_KEY=your_access_key
OBJECT_STORAGE_SECRET_KEY=your_secret_key
OBJECT_STORAGE_REGION=us-east-1
UPLOADS_BUCKET=aphura-uploads
TRANSCRIPTION_BUCKET=aphura-transcription
KNOWLEDGE_BANK_BUCKET=aphura-knowledge-bank
KNOWLEDGEBOT_BUCKET=aphura-knowledgebot
PRESENTATION_BUCKET=aphura-presentations

# ── Tool Integrations (Composio) ─────────────────────────────────────────────
COMPOSIO_API_KEY=your_composio_api_key
COMPOSIO_BASE_URL=https://backend.composio.dev
COMPOSIO_MCP_URL=https://connect.composio.dev/mcp

# ── Cloudflare Edge ──────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id

# ── Durable Workflows (Temporal) ─────────────────────────────────────────────
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default

# ── OpenStack Sovereign Compute (Liberty Center One) ─────────────────────────
OPENSTACK_AUTH_URL=https://identity.libertycenterone.com/v3
OPENSTACK_NOVA_URL=https://compute.libertycenterone.com/v2.1
OPENSTACK_CINDER_URL=https://volume.libertycenterone.com/v3
OPENSTACK_GLANCE_URL=https://image.libertycenterone.com/v2
OPENSTACK_BARBICAN_URL=https://key-manager.libertycenterone.com/v1
OPENSTACK_OCTAVIA_URL=https://load-balancer.libertycenterone.com/v2
OPENSTACK_HEAT_URL=https://orchestration.libertycenterone.com/v1
OPENSTACK_NEUTRON_URL=https://network.libertycenterone.com/v2.0
OPENSTACK_USERNAME=your_openstack_username
OPENSTACK_PASSWORD=your_openstack_password
OPENSTACK_PROJECT_NAME=Aphura
OPENSTACK_USER_DOMAIN_NAME=Default

# ── Smart Routing & Telemetry ────────────────────────────────────────────────
ENABLE_SMART_ROUTING=true
CODE_QUERY_CONFIDENCE_THRESHOLD=0.7
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=aphura-ai
